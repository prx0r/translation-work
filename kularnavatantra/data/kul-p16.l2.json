  "supplied": []
 },
 {
  "verse_id": "kul-p16-v387",
  "song": "kul-p16",
  "verse": 387,
  "plain_english": "Because of being the form of light and bliss, and because of giving direct fruit.",
  "sanskrit_cite": "prakāśānandarūpatvāt pratyakṣaphaladānataḥ",
  "l0_ids": [
   "kul-p16-v387-p000",
   "kul-p16-v387-p001"

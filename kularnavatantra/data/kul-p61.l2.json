  "l0_ids": [
   "kul-p61-v1507-p000",
   "kul-p61-v1507-p001",
   "kul-p61-v1507-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1508",
  "song": "kul-p61",
  "verse": 1508,
  "plain_english": "He is affectionate to true devotees, steadfast, compassionate, and speaks with a smile.",
  "sanskrit_cite": "sadbhaktavatsalo dhīraḥ kṛpāluḥ smitapūrṇavāk",
  "l0_ids": [
   "kul-p61-v1508-p000",
   "kul-p61-v1508-p001",
   "kul-p61-v1508-p002",
   "kul-p61-v1508-p003"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1509",
  "song": "kul-p61",
  "verse": 1509,
  "plain_english": "He honors his chosen deity, guru, and elders, and is eager in worship of women.",
  "sanskrit_cite": "sveṣṭadevagurujyeṣṭha vanitāpūjanotsukaḥ",
  "l0_ids": [
   "kul-p61-v1509-p000",
   "kul-p61-v1509-p001"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1510",
  "song": "kul-p61",
  "verse": 1510,
  "plain_english": "He is free from passion, aversion, fear, affliction, pride, and ego.",

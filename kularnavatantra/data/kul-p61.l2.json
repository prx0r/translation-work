  "l0_ids": [
   "kul-p61-v1510-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1511",
  "song": "kul-p61",
  "verse": 1511,
  "plain_english": "He is content with chance gains and discriminates virtue from vice.",

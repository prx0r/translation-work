[
 {
  "verse_id": "kul-p61-v1501",
  "song": "kul-p61",
  "verse": 1501,
  "plain_english": "The guru should accept a disciple endowed with these characteristics.",
  "sanskrit_cite": "ityādilakṣaṇopetaṃ guruḥ śiṣyaṃ parigrahet",
  "l0_ids": [
   "kul-p61-v1501-p000",
   "kul-p61-v1501-p001",
   "kul-p61-v1501-p002",
   "kul-p61-v1501-p003"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1502",
  "song": "kul-p61",
  "verse": 1502,
  "plain_english": "He is endowed with all characteristics and beautified in every limb.",
  "sanskrit_cite": "sarvalakṣaṇasampannaḥ sarvāvayavaśobhitaḥ",
  "l0_ids": [
   "kul-p61-v1502-p000",
   "kul-p61-v1502-p001"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1503",
  "song": "kul-p61",
  "verse": 1503,
  "plain_english": "He enchants the world, appears god-like, and has a pleasant appearance.",
  "sanskrit_cite": "lokasammohanakaro devavat priyadarśanaḥ",
  "l0_ids": [
   "kul-p61-v1503-p000",
   "kul-p61-v1503-p001",
   "kul-p61-v1503-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1504",
  "song": "kul-p61",
  "verse": 1504,
  "plain_english": "He knows gestures and forms, is wise, and shines in inference and refutation.",
  "sanskrit_cite": "iṅgitākāravit prājña ūhāpohavidujjvalaḥ",
  "l0_ids": [
   "kul-p61-v1504-p000",
   "kul-p61-v1504-p001",
   "kul-p61-v1504-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1505",
  "song": "kul-p61",
  "verse": 1505,
  "plain_english": "He knows the accomplishment of commands across three times and is capable of restraint and grace.",
  "sanskrit_cite": "ājñāsiddhistrikālajño nigrahānugrahakṣamaḥ",
  "l0_ids": [
   "kul-p61-v1505-p000",
   "kul-p61-v1505-p001"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1506",
  "song": "kul-p61",
  "verse": 1506,
  "plain_english": "They are capable of controlling the senses and conquering the six enemies.",
  "sanskrit_cite": "svādhīnendriyasañcāraṣaḍvargavijayakṣamāḥ",
  "l0_ids": [
   "kul-p61-v1506-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1507",
  "song": "kul-p61",
  "verse": 1507,
  "plain_english": "The saint is equal to Shiva and Vishnu and destroys dull vision.",

  "l0_ids": [
   "kul-p61-v1511-p000",
   "kul-p61-v1511-p001"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1512",
  "song": "kul-p61",
  "verse": 1512,
  "plain_english": "He is endowed with all ego-state, free from dualities, and fixed in vow.",

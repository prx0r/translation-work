  "l0_ids": [
   "kul-p61-v1512-p000",
   "kul-p61-v1512-p001",
   "kul-p61-v1512-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p61-v1513",
  "song": "kul-p61",
  "verse": 1513,
  "plain_english": "The teacher is one who is not a seller of mantras, yantras, tantras, and similar things, and is endowed with wealth, knowledge, and other such qualities.",

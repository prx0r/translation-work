   "kul-p79-v1958-p005"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1959",
  "song": "kul-p79",
  "verse": 1959,
  "plain_english": "This is the sixteenth chapter, named the discourse on desire-driven rites.",

  "l0_ids": [
   "kul-p79-v1962-p000",
   "kul-p79-v1962-p001"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1963",
  "song": "kul-p79",
  "verse": 1963,
  "plain_english": "To consciousness, the radiance that breaks all ignorance-darkness, and.",

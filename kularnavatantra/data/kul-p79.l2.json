   "kul-p79-v1959-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1960",
  "song": "kul-p79",
  "verse": 1960,
  "plain_english": "O Supreme Lord, tell me the truth of the principles of Kula.",
  "sanskrit_cite": "tattvaṃ kulapadārthānāṃ vada me parameśvara",

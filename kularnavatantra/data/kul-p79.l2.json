   "kul-p79-v1956-p005"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1957",
  "song": "kul-p79",
  "verse": 1957,
  "plain_english": "O Goddess, by this meditation one may destroy even time and other such forces.",
  "sanskrit_cite": "dhyānenānena deveśi kālādīnapi nāśayet",

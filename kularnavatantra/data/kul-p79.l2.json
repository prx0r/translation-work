[
 {
  "verse_id": "kul-p79-v1951",
  "song": "kul-p79",
  "verse": 1951,
  "plain_english": "That seed, called Parāprāsāda, has a radiance equal to the fire at the end of a cosmic age.",
  "sanskrit_cite": "parāprāsādabījaṃ tat kalpāntāgnisamaprabham",
  "l0_ids": [
   "kul-p79-v1951-p000",
   "kul-p79-v1951-p001",
   "kul-p79-v1951-p002",
   "kul-p79-v1951-p003",
   "kul-p79-v1951-p004"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1952",
  "song": "kul-p79",
  "verse": 1952,
  "plain_english": "It is itself equal to the fire of time and terrifying to all beings.",
  "sanskrit_cite": "svayaṃ kālānalasamaḥ sarvabhūtabhayaṅkaraḥ",
  "l0_ids": [
   "kul-p79-v1952-p000",
   "kul-p79-v1952-p001",
   "kul-p79-v1952-p002",
   "kul-p79-v1952-p003",
   "kul-p79-v1952-p004"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1953",
  "song": "kul-p79",
  "verse": 1953,
  "plain_english": "The one named Parāprāsāda is accompanied by youthful exuberance.",
  "sanskrit_cite": "yauvanollāsasahitaḥ parāprāsādasaṃjñakam",
  "l0_ids": [
   "kul-p79-v1953-p000",
   "kul-p79-v1953-p001",
   "kul-p79-v1953-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1954",
  "song": "kul-p79",
  "verse": 1954,
  "plain_english": "It targets beings who do harm and those who cause quarrels and trouble.",
  "sanskrit_cite": "aniṣṭakāriṇaḥ sattvān kalahāyāsakāriṇaḥ",
  "l0_ids": [
   "kul-p79-v1954-p000",
   "kul-p79-v1954-p001",
   "kul-p79-v1954-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1955",
  "song": "kul-p79",
  "verse": 1955,
  "plain_english": "It targets spirits, possessing entities, vetālas, piśācas, yakṣas, and rākṣasas.",
  "sanskrit_cite": "bhūtopagrahavetālān piśācān yakṣarākṣasān",
  "l0_ids": [
   "kul-p79-v1955-p000",
   "kul-p79-v1955-p001",
   "kul-p79-v1955-p002"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1956",
  "song": "kul-p79",
  "verse": 1956,
  "plain_english": "In an instant they go to destruction, like moths in a fire.",
  "sanskrit_cite": "kṣaṇena nāśamāyānti śalabhā iva pāvake",
  "l0_ids": [
   "kul-p79-v1956-p000",
   "kul-p79-v1956-p001",

   "kul-p79-v1960-p000",
   "kul-p79-v1960-p001",
   "kul-p79-v1960-p002",
   "kul-p79-v1960-p003",
   "kul-p79-v1960-p004"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1961",
  "song": "kul-p79",
  "verse": 1961,
  "plain_english": "By merely hearing it, knowledge of Kula shines forth.",
  "sanskrit_cite": "tasya śravaṇamātreṇa kulajñānaṃ prakāśate",
  "l0_ids": [
   "kul-p79-v1961-p000",
   "kul-p79-v1961-p001",
   "kul-p79-v1961-p002",
   "kul-p79-v1961-p003"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1962",
  "song": "kul-p79",
  "verse": 1962,

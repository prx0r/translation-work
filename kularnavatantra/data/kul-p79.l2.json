  "l0_ids": [
   "kul-p79-v1969-p000",
   "kul-p79-v1969-p001"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1970",
  "song": "kul-p79",
  "verse": 1970,

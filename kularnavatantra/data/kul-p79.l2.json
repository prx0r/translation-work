   "kul-p79-v1957-p005"
  ],
  "supplied": []
 },
 {
  "verse_id": "kul-p79-v1958",
  "song": "kul-p79",
  "verse": 1958,
  "plain_english": "O Lady of Kula, I have spoken in brief; what more do you wish to hear?",
  "sanskrit_cite": "samāsena kuleśāni ki bhūyaḥ śrotumicchasi",

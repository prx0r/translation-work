 },
 {
  "verse_id": "mukta-m0-p10-v231",
  "song": "mukta-m0-p10",
  "verse": 231,
  "plain_english": "It is not contradicted by those particular statements nor by general ones.",
  "sanskrit_cite": "na tābhirabhibhāṣyābhiḥ sāmānyābhiśca bādhyate",
  "l0_ids": [
   "mukta-m0-p10-v231-p000",

  "song": "mukta-m0-p262",
  "verse": 6544,
  "plain_english": "Alternatively, for others it may be three or eight fingers, or sixteen fingers.",
  "sanskrit_cite": "śalyavasvaṅgulānvātha pareṣāṃ ṣoḍaśāṅgulam",
  "l0_ids": [
   "mukta-m0-p262-v6544-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6545",
  "song": "mukta-m0-p262",
  "verse": 6545,
  "plain_english": "Or it may be half the measure of the rise, as is prescribed at the beginning.",
  "sanskrit_cite": "udayārdhapramāṇaṃ vā yādādau paripaṭhyate",
  "l0_ids": [
   "mukta-m0-p262-v6545-p000"
  ],
  "supplied": []
 },
 {

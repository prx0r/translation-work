 },
 {
  "verse_id": "mukta-m0-p262-v6543",
  "song": "mukta-m0-p262",
  "verse": 6543,
  "plain_english": "Among these, an increase beyond the cubit is recognized, marked as appropriate for its own proportional growth.",
  "sanskrit_cite": "teṣu hastāt paraḥ khyātaḥ svavṛddhyarhopalakṣitaḥ",
  "l0_ids": [
   "mukta-m0-p262-v6543-p000"
  ],
  "supplied": []
 },
 {

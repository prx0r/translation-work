[
 {
  "verse_id": "mukta-m0-p262-v6526",
  "song": "mukta-m0-p262",
  "verse": 6526,
  "plain_english": "It should be thirty-six fingers in length and eight fingers in width.",
  "sanskrit_cite": "ṣaṭtriṃśadaṅgulāyāmamaṣṭāṅgulasuvistaram",
  "l0_ids": [
   "mukta-m0-p262-v6526-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6527",
  "song": "mukta-m0-p262",
  "verse": 6527,
  "plain_english": "In its width and length, it should resemble the face of a boar.",
  "sanskrit_cite": "vistāreṇa ca dairghyeṇa sūkarānanasannibham",
  "l0_ids": [
   "mukta-m0-p262-v6527-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6528",
  "song": "mukta-m0-p262",
  "verse": 6528,
  "plain_english": "The ear should be two measures in length and four fingers in width.",
  "sanskrit_cite": "karṇadairghyaṃ dvimātraṃ syādvistāraṃ caturaṅgulam",
  "l0_ids": [
   "mukta-m0-p262-v6528-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6529",
  "song": "mukta-m0-p262",
  "verse": 6529,
  "plain_english": "It may be three or four measures, and a hole is prescribed in its middle.",
  "sanskrit_cite": "trimātraṃ vā caturmātraṃ tanmadhye bilamucyate",
  "l0_ids": [
   "mukta-m0-p262-v6529-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6530",
  "song": "mukta-m0-p262",
  "verse": 6530,
  "plain_english": "It should be made four fingers, increasing by a quarter finger at a time.",
  "sanskrit_cite": "ardhārdhāṅgulavṛddhyā tu kartavyaṃ caturaṅgulam",
  "l0_ids": [
   "mukta-m0-p262-v6530-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6531",
  "song": "mukta-m0-p262",
  "verse": 6531,
  "plain_english": "The sruk should be made, and the sruva likewise should have its measure derived from the same source.",
  "sanskrit_cite": "sruk syāt sruve'pi tadyonistanmānaṃ tastato bhavet",
  "l0_ids": [
   "mukta-m0-p262-v6531-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6532",
  "song": "mukta-m0-p262",
  "verse": 6532,
  "plain_english": "The circumference should be six fingers at the base of the handle and at the lotus.",
  "sanskrit_cite": "ṣaḍaṅgulapaśīṇāho daṇḍamūle ca puṣkare",
  "l0_ids": [
   "mukta-m0-p262-v6532-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6533",
  "song": "mukta-m0-p262",
  "verse": 6533,
  "plain_english": "The place for ghee at its tip should be made in the shape of a tower.",
  "sanskrit_cite": "gopurākāravat kāryamājyasthānaṃ tadagrake",
  "l0_ids": [
   "mukta-m0-p262-v6533-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6534",
  "song": "mukta-m0-p262",
  "verse": 6534,
  "plain_english": "A new implement is best; an old one may be used only if a new one is not available.",
  "sanskrit_cite": "nūtanaṃ karaṇaṃ śreṣṭhaṃ purāṇaṃ tadabhāvataḥ",
  "l0_ids": [
   "mukta-m0-p262-v6534-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6535",
  "song": "mukta-m0-p262",
  "verse": 6535,
  "plain_english": "It should be used only after prior authorization, and then it may serve as the implement for enjoyment.",
  "sanskrit_cite": "tadājñāpūrvakaṃ sa syāttadbhogyakaraṇaṃ tataḥ",
  "l0_ids": [
   "mukta-m0-p262-v6535-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6536",
  "song": "mukta-m0-p262",
  "verse": 6536,
  "plain_english": "The rite follows the scripture and the place according to which it was previously conducted.",
  "sanskrit_cite": "yena śāstreṇa yatsthāne kriyā pūrvaṃ pravartate",
  "l0_ids": [
   "mukta-m0-p262-v6536-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6537",
  "song": "mukta-m0-p262",
  "verse": 6537,
  "plain_english": "Whatever is not stated should be taken from elsewhere in festivals and other rites.",
  "sanskrit_cite": "anuktamanyato gāhyamutsavādiṣu karmasu",
  "l0_ids": [
   "mukta-m0-p262-v6537-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6538",
  "song": "mukta-m0-p262",
  "verse": 6538,
  "plain_english": "Even if it is excellent and accomplished in its own place, an object situated in another shrine should not be taken.",
  "sanskrit_cite": "śreṣṭhastaddhāmasaṃsiddho na grāhyo'nyālayasthitaḥ",
  "l0_ids": [
   "mukta-m0-p262-v6538-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6539",
  "song": "mukta-m0-p262",
  "verse": 6539,
  "plain_english": "If an established image or the like is favorable and compatible with that deity's sign and other features, it may be considered.",
  "sanskrit_cite": "talliṅgādyanukūlaṃ cedberādyaṃ yat pratiṣṭhitam",
  "l0_ids": [
   "mukta-m0-p262-v6539-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6540",
  "song": "mukta-m0-p262",
  "verse": 6540,
  "plain_english": "One should perform rites to purify the defect arising from transferring it from one place to another.",
  "sanskrit_cite": "sthānāt sthānāntaraprāptidoṣaśuddhyarthamācaret",
  "l0_ids": [
   "mukta-m0-p262-v6540-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6541",
  "song": "mukta-m0-p262",
  "verse": 6541,
  "plain_english": "It should be accompanied by abundant worship using the short prāsāda mantra.",
  "sanskrit_cite": "hrasvaprāsādamantreṇa prabhūtayajanānvitam",
  "l0_ids": [
   "mukta-m0-p262-v6541-p000"
  ],
  "supplied": []
 },
 {
  "verse_id": "mukta-m0-p262-v6542",
  "song": "mukta-m0-p262",
  "verse": 6542,
  "plain_english": "The height of the kanyasa structures should be five, six, or seven cubits.",
  "sanskrit_cite": "pañcaṣaṭsaptahastāni kanyasānāṃ samucchrayaḥ",
  "l0_ids": [
   "mukta-m0-p262-v6542-p000"
  ],

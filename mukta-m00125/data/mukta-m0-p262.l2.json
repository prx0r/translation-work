  "song": "mukta-m0-p262",
  "verse": 6546,
  "plain_english": "The rite for well-being is to be performed properly; listen, O twice-born ones.",
  "sanskrit_cite": "saukhyakarma prakartavyaṃ yathāvacchṛṇuta dvijāḥ",
  "l0_ids": [
   "mukta-m0-p262-v6546-p000"

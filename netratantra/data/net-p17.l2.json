   "net-p17-v406-p001",
   "net-p17-v406-p002",
   "net-p17-v406-p003"
  ],
  "supplied": []
 },
 {
  "verse_id": "net-p17-v407",
  "song": "net-p17",
  "verse": 407,
  "plain_english": "Indeed, these kalās are absorbing, for they absorb all the gods.",
  "sanskrit_cite": "nirodhikā kalā hyetā sarvadevanirodhikāḥ",

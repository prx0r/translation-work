{
 "structural_schema_version": "2.1.0",
 "base_schema_version": "1.4.0",
 "layers": {
  "t1": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:t1",
   "title": "Svatantrya T1 structural schema",
   "x-validator": "schemas.t1.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "verse_id",
    "song",
    "verse",
    "quick_english",
    "tokens",
    "source_sha"
   ],
   "properties": {
    "verse_id": {
     "type": "string",
     "minLength": 1
    },
    "song": {
     "type": "string",
     "minLength": 1
    },
    "verse": {
     "type": "integer",
     "minimum": 1
    },
    "quick_english": {
     "type": "string",
     "minLength": 1
    },
    "source_sha": {
     "type": "string",
     "minLength": 1
    },
    "tokens": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "surface",
       "quick_gloss"
      ],
      "properties": {
       "surface": {
        "type": "string",
        "minLength": 1
       },
       "quick_gloss": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "l0": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:l0:verse",
   "title": "Svatantrya L0 verse token list structural schema",
   "x-validator": "schemas.l0.validate (per token)",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "array",
   "minItems": 1,
   "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:svatantrya:schema:2.1.0:l0",
    "title": "Svatantrya L0 structural schema",
    "x-validator": "schemas.l0.validate",
    "x-schema-version": "1.4.0",
    "x-structural-schema-version": "2.1.0",
    "type": "object",
    "required": [
     "id",
     "verse_id",
     "pada_index",
     "surface",
     "citation",
     "options",
     "chosen_index",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "verse_id": {
      "type": "string",
      "minLength": 1
     },
     "pada_index": {
      "type": "integer",
      "minimum": 0
     },
     "surface": {
      "type": "string",
      "minLength": 1
     },
     "citation": {
      "type": "string",
      "minLength": 1
     },
     "morph": {
      "type": "string"
     },
     "morph_unknown": {
      "type": "boolean"
     },
     "options": {
      "type": "array",
      "maxItems": 5,
      "items": {
       "type": "object",
       "required": [
        "gloss",
        "rank",
        "source",
        "grounds"
       ],
       "properties": {
        "gloss": {
         "type": "string",
         "minLength": 1
        },
        "rank": {
         "type": "integer",
         "minimum": 1
        },
        "source": {
         "type": "string",
         "minLength": 1
        },
        "grounds": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "chosen_index": {
      "type": "integer",
      "minimum": 0
     },
     "status": {
      "type": "string",
      "enum": [
       "PARSED",
       "AMBIGUOUS",
       "FAILED"
      ]
     },
     "revised": {
      "type": "boolean"
     },
     "revise_reason": {
      "type": "string"
     },
     "fork": {
      "type": "string",
      "enum": [
       "none",
       "live",
       "resolved"
      ]
     }
    }
   }
  },
  "argmap": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:argmap",
   "title": "Svatantrya ARGMAP structural schema",
   "x-validator": "schemas.argmap.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "verse_id",
    "song",
    "verse",
    "traces",
    "sanskrit_sha"
   ],
   "properties": {
    "verse_id": {
     "type": "string",
     "minLength": 1
    },
    "traces": {
     "type": "object",
     "required": [
      "t1_verse",
      "l0_ids"
     ],
     "properties": {
      "t1_verse": {
       "type": "string",
       "minLength": 1
      },
      "l0_ids": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       },
       "minItems": 1
      }
     }
    },
    "song": {
     "type": "string",
     "minLength": 1
    },
    "verse": {
     "type": "integer",
     "minimum": 1
    },
    "sanskrit_sha": {
     "type": "string",
     "minLength": 1
    },
    "speaker": {
     "type": "string",
     "minLength": 1
    },
    "question": {
     "type": "string",
     "minLength": 1
    },
    "inference": {
     "type": "string",
     "minLength": 1
    },
    "reconstruction": {
     "type": "string",
     "minLength": 1
    },
    "premises": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "uncertainties": {
     "type": "array"
    },
    "structured": {
     "type": "boolean"
    }
   }
  },
  "l2": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:l2",
   "title": "Svatantrya L2 structural schema",
   "x-validator": "schemas.l2.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "verse_id",
    "song",
    "verse",
    "plain_english",
    "sanskrit_cite",
    "l0_ids"
   ],
   "properties": {
    "verse_id": {
     "type": "string",
     "minLength": 1
    },
    "song": {
     "type": "string",
     "minLength": 1
    },
    "verse": {
     "type": "integer",
     "minimum": 1
    },
    "plain_english": {
     "type": "string",
     "minLength": 1
    },
    "sanskrit_cite": {
     "type": "string",
     "minLength": 1
    },
    "l0_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "supplied": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "c1": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:c1",
   "title": "Svatantrya C1 structural schema",
   "x-validator": "schemas.c1.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "song",
    "essence",
    "renders"
   ],
   "properties": {
    "song": {
     "type": "string",
     "minLength": 1
    },
    "essence": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "renders": {
     "type": "object",
     "required": [
      "standard"
     ]
    }
   }
  },
  "l3": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:l3",
   "title": "Svatantrya L3 structural schema",
   "x-validator": "schemas.l3.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "verse_id",
    "song",
    "verse",
    "lines",
    "sanskrit_cite",
    "l0_ids",
    "essence_maps"
   ],
   "properties": {
    "verse_id": {
     "type": "string",
     "minLength": 1
    },
    "song": {
     "type": "string",
     "minLength": 1
    },
    "verse": {
     "type": "integer",
     "minimum": 1
    },
    "lines": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "sanskrit_cite": {
     "type": "string",
     "minLength": 1
    },
    "l0_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "essence_maps": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": 1
    }
   }
  },
  "l4": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:l4",
   "title": "Svatantrya L4 structural schema",
   "x-validator": "schemas.l4.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "verse_id",
    "song",
    "verse",
    "lines",
    "sanskrit_cite",
    "l0_ids",
    "essence_maps"
   ],
   "properties": {
    "verse_id": {
     "type": "string",
     "minLength": 1
    },
    "song": {
     "type": "string",
     "minLength": 1
    },
    "verse": {
     "type": "integer",
     "minimum": 1
    },
    "lines": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "sanskrit_cite": {
     "type": "string",
     "minLength": 1
    },
    "l0_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "essence_maps": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": 1
    }
   }
  },
  "c2": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:svatantrya:schema:2.1.0:c2",
   "title": "Svatantrya C2 structural schema",
   "x-validator": "schemas.c2.validate",
   "x-schema-version": "1.4.0",
   "x-structural-schema-version": "2.1.0",
   "type": "object",
   "required": [
    "song",
    "renders"
   ],
   "properties": {
    "song": {
     "type": "string",
     "minLength": 1
    },
    "renders": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "style",
       "prompt",
       "paragraphs"
      ],
      "properties": {
       "style": {
        "type": "string",
        "minLength": 1
       },
       "prompt": {
        "type": "string",
        "minLength": 1
       },
       "paragraphs": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "text",
          "maps_to"
         ],
         "properties": {
          "text": {
           "type": "string",
           "minLength": 1
          },
          "maps_to": {
           "type": "array",
           "items": {
            "type": "integer",
            "minimum": 0
           },
           "minItems": 1
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
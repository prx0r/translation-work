  ]
 },
 {
  "verse_id": "s02-v02",
  "song": "s02",
  "verse": 2,
  "final_english": "To the great fire — universe for fuel, bright with great ash smeared pure — to Thee, the Becoming, whose one offering is the world — bow.",

[
 {
  "verse_id": "s02-v01",
  "song": "s02",
  "verse": 1,
  "final_english": "Fire, moon, sun — Brahmā, Viṣṇu — still things, moving things: Your very stuff. To the many-shaped — to You, shaped of knowing — bow.",

   "s06-v09-p012",
   "s06-v09-p013",
   "s06-v09-p014"
  ]
 },
 {
  "verse_id": "s06-v10",
  "song": "s06",
  "verse": 10,
  "final_english": "Thy limb-embrace's joy — by my will alone may it befall me. This much won — what, Lord, have I not won?",
  "l0_ids": [
   "s06-v10-p000",
   "s06-v10-p001",

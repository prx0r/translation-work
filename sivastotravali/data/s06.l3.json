[
 {
  "verse_id": "s06-v01",
  "song": "s06",
  "verse": 1,
  "final_english": "Though parted from Thee, Ruler, though it be a mere instant — I ever thick-burning: may I be ground for Thy glance.",
  "l0_ids": [
   "s06-v01-p000",
   "s06-v01-p001",
   "s06-v01-p002",
   "s06-v01-p003",
   "s06-v01-p004",
   "s06-v01-p005",
   "s06-v01-p006",
   "s06-v01-p007",
   "s06-v01-p008",
   "s06-v01-p009",
   "s06-v01-p010"
  ]
 },
 {
  "verse_id": "s06-v02",
  "song": "s06",
  "verse": 2,
  "final_english": "In parting-pithed passing — by Thee, dear Master — may I be ever unparted, though from the world parted.",
  "l0_ids": [
   "s06-v02-p000",
   "s06-v02-p001",
   "s06-v02-p002",
   "s06-v02-p003",
   "s06-v02-p004",
   "s06-v02-p005",
   "s06-v02-p006",
   "s06-v02-p007",
   "s06-v02-p008",
   "s06-v02-p009"
  ]
 },
 {
  "verse_id": "s06-v03",
  "song": "s06",
  "verse": 3,
  "final_english": "Body, speech, mind — where I go with them, all is Thou alone. May this highest truth stand full for me, ever.",
  "l0_ids": [
   "s06-v03-p000",
   "s06-v03-p001",
   "s06-v03-p002",
   "s06-v03-p003",
   "s06-v03-p004",
   "s06-v03-p005",
   "s06-v03-p006",
   "s06-v03-p007",
   "s06-v03-p008",
   "s06-v03-p009",
   "s06-v03-p010",
   "s06-v03-p011",
   "s06-v03-p012",
   "s06-v03-p013",
   "s06-v03-p014"
  ]
 },
 {
  "verse_id": "s06-v04",
  "song": "s06",
  "verse": 4,
  "final_english": "Thought-free as Thou, great-bliss-full as Thou — so may my praise-making speech match, and only match.",
  "l0_ids": [
   "s06-v04-p000",
   "s06-v04-p001",
   "s06-v04-p002",
   "s06-v04-p003",
   "s06-v04-p004",
   "s06-v04-p005",
   "s06-v04-p006",
   "s06-v04-p007",
   "s06-v04-p008",
   "s06-v04-p009"
  ]
 },
 {
  "verse_id": "s06-v05",
  "song": "s06",
  "verse": 5,
  "final_english": "Held by Thee — seeing thing and thing Thou-made — may I roam longing-free, joy-brimmed.",
  "l0_ids": [
   "s06-v05-p000",
   "s06-v05-p001",
   "s06-v05-p002",
   "s06-v05-p003",
   "s06-v05-p004",
   "s06-v05-p005",
   "s06-v05-p006",
   "s06-v05-p007"
  ]
 },
 {
  "verse_id": "s06-v06",
  "song": "s06",
  "verse": 6,
  "final_english": "Lord, may I see the all-world full of Thy being — with that alone content. Then — no more wearing.",
  "l0_ids": [
   "s06-v06-p000",
   "s06-v06-p001",
   "s06-v06-p002",
   "s06-v06-p003",
   "s06-v06-p004",
   "s06-v06-p005",
   "s06-v06-p006",
   "s06-v06-p007",
   "s06-v06-p008",
   "s06-v06-p009"
  ]
 },
 {
  "verse_id": "s06-v07",
  "song": "s06",
  "verse": 7,
  "final_english": "Melting in Thee alone — like cloud-shreds in sky — may things shine for me, ever, step by step stainless.",
  "l0_ids": [
   "s06-v07-p000",
   "s06-v07-p001",
   "s06-v07-p002",
   "s06-v07-p003",
   "s06-v07-p004",

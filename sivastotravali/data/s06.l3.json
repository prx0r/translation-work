   "s06-v07-p010"
  ]
 },
 {
  "verse_id": "s06-v08",
  "song": "s06",
  "verse": 8,
  "final_english": "Self-light outspread, shattering the endless dark-train — shine for me ever: some jewel of Thy being, from Thy middle.",
  "l0_ids": [
   "s06-v08-p000",
   "s06-v08-p001",
   "s06-v08-p002",
   "s06-v08-p003",
   "s06-v08-p004",
   "s06-v08-p005",
   "s06-v08-p006"
  ]
 },
 {
  "verse_id": "s06-v09",
  "song": "s06",
  "verse": 9,
  "final_english": "What ground rulest Thou not? What could it be, not Thy body? Weary — thereby, by no-effort, may I win Thee everywhere.",
  "l0_ids": [
   "s06-v09-p000",
   "s06-v09-p001",
   "s06-v09-p002",

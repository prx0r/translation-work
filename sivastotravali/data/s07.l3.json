  ]
 },
 {
   "verse_id": "s07-v04",
   "song": "s07",
   "verse": 4,
   "final_english": "Me, wallowing in passion's world-egg — O Thy-love-thought Mother, plump me with sap on sap, that wing-grown I turn sky-goer.",

  ]
 },
 {
  "verse_id": "s07-v06",
  "song": "s07",
  "verse": 6,
  "final_english": "By Thy-love-sun's ray-touch may this mind-jewel of mine shed far-off passion-kindled fire-sparks.",
  "l0_ids": [

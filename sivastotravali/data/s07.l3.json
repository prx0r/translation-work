  ]
 },
 {
  "verse_id": "s07-v05",
  "song": "s07",
  "verse": 5,
  "final_english": "May this mind of mine win connoisseurship — savoring Thy-foot-thought-nectar-sap's pith — till sense-poison-clinging hankers no more.",
  "l0_ids": [
   "s07-v05-p000",

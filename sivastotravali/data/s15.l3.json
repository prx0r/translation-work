 },
 {
  "verse_id": "s15-v10",
  "song": "s15",
  "verse": 10,
  "final_english": "To be guarded, to be grown, to be honored — this, Ruler: passing's ill-faring-smasher, Thy-love's great hoard.",
  "l0_ids": [
   "s15-v10-p000",
   "s15-v10-p001",

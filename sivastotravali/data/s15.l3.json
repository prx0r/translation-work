   "s15-v06-p010"
  ]
 },
 {
  "verse_id": "s15-v07",
  "song": "s15",
  "verse": 7,
  "final_english": "Stir-and-still's Lord, Master — though blind, though leprous — they shine past measure, wild-Thy-love-jeweled.",

   "s15-v01-p009"
  ]
 },
 {
  "verse_id": "s15-v02",
  "song": "s15",
  "verse": 2,
  "final_english": "Sated with Māyā-time-fate-love-and-Co. for food, they stroll glad, Lord — love-ful — on the world's shore.",
  "l0_ids": [
   "s15-v02-p000",
   "s15-v02-p001",
   "s15-v02-p002",
   "s15-v02-p003",

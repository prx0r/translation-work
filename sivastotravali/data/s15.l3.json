   "s15-v04-p008"
  ]
 },
 {
  "verse_id": "s15-v05",
  "song": "s15",
  "verse": 5,
  "final_english": "Who, dragging the outside into heart's inside itself, worships Thee, Ruler — with love-nectar-sap-floods him I bow.",

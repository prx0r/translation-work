   "s15-v02-p005"
  ]
 },
 {
  "verse_id": "s15-v03",
  "song": "s15",
  "verse": 3,
  "final_english": "Weeping or laughing, Thee aloud they babble — these lovers; praise-word-lift-offerings apart indeed are they.",

  ]
 },
 {
  "verse_id": "s15-v06",
  "song": "s15",
  "verse": 6,
  "final_english": "'Tween right and unright selves, 'tween doings, 'tween knowings — so 'tween joy-and-pain selves — lovers taste some. Ah!",

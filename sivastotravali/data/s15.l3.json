[
 {
  "verse_id": "s15-v01",
  "song": "s15",
  "verse": 1,
  "final_english": "Stain-washing books there are, and their far-siders too; yogins, pundits stand hale — Thy lovers alone, in truth.",
  "l0_ids": [
   "s15-v01-p000",
   "s15-v01-p001",

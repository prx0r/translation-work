  ]
 },
 {
  "verse_id": "s15-v04",
  "song": "s15",
  "verse": 4,
  "final_english": "No passionless one, no master either, no freedom-hungerer is Thy worshipper. May I be — but — brimming-love-wine-sap-mad.",
  "l0_ids": [
   "s15-v04-p000",
   "s15-v04-p001",
   "s15-v04-p002",

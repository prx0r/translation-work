   "s15-v07-p008"
  ]
 },
 {
  "verse_id": "s15-v08",
  "song": "s15",
  "verse": 8,
  "final_english": "Gleaners, grain-pickers, foes' shadow-limbed even, Ruler — by Thy-love's great heat the king of kings even they lord.",
  "l0_ids": [
   "s15-v08-p000",
   "s15-v08-p001",
   "s15-v08-p002",
   "s15-v08-p003",
   "s15-v08-p004",
   "s15-v08-p005"
  ]
 },
 {
  "verse_id": "s15-v09",
  "song": "s15",
  "verse": 9,
  "final_english": "In nectar-wet Thy-love though wallowing, yet climb-hungering — with mind alone, All, some worship Thee, standing round about.",
  "l0_ids": [
   "s15-v09-p000",
   "s15-v09-p001",

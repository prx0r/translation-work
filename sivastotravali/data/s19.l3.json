 },
 {
  "verse_id": "s19-v05",
  "song": "s19",
  "verse": 5,
  "final_english": "Thy-stainless-feet-thought-jewel-creeper-decked — when, ripening, perfect-folks'-minds'-wonder-birthing, befall me from Thee?",

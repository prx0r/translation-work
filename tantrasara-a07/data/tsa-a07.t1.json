[
 {
  "verse_id": "tsa-a07-v01",
  "song": "tsa-a07",
  "verse": 1,
  "quick_english": "Therein this whole — of-place-path-illumination-power-born, rested in consciousness: through its door, in void, mind, prāṇa, nerve-circles-within, outside in body up to liṅga-sthaṇḍila-image — the whole path is firmly fixed. Having melted that whole path into the body, the body into prāṇa, that into mind, that into void, in that consciousness — all-filled-full-consciousness is attained: knowing the thirty-six tattvas' own-form, seeing beyond-it consciousness Supreme-Siva-formed, even world-made consciousness would make-known — the beyond-portion-of-knowable just as some, taking-as-supreme the māyā-womb-qualified, Viṣṇu-Brahmā-and-rest. Therefore it must be by prakriyā-knowledge-endowed.",
  "quick_english_source": "manual",

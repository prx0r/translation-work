[
 {
  "verse_id": "tsa-a17-v01",
  "song": "tsa-a17",
  "verse": 1,
  "quick_english": "For those standing in scriptures from Vaiṣṇava ones to southern tantras at the end, or vow-takers thereof, and even highest-scripture-standers serving unentitled lower-scripture gurus — when by the Lord's power-descent they are turned hither, then this is their rule: therein the fast-observed one on the next day — worshipped with the common mantra, his doings told — let him be led before the Lord; there, having taken his vow, let him cast it in water; then let him bathe; then having sprinkled, having purified with gruel and tooth-stick, having led him blindfolded in, by the common mantra let him have the Lord's worship performed.",
  "quick_english_source": "manual",
